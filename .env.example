# --- Required ---
# Google Gemini API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# MongoDB connection string (Atlas free tier M0): mongodb+srv://user:pass@cluster/dbname
MONGODB_URI=
MONGODB_DB=interview_prep_kit

# Secret used to sign session JWTs (any long random string)
AUTH_SECRET=

# --- Recommended ---
# Tavily API key for public interview-discussion search (free tier): https://tavily.com
# If omitted, that research step is skipped gracefully rather than failing.
TAVILY_API_KEY=

# --- Optional tuning (sensible defaults applied if unset) ---
# LLM_MODEL=gemini-3.5-flash-lite   # fast, high free-tier throughput; flash tiers are slower/overloaded
# LLM_MIN_GAP_MS=4500          # min gap between model calls; keeps us under the RPM limit
# LLM_MAX_ATTEMPTS=6           # retries with exponential backoff on 429/5xx
# COVERAGE_MAX_PASSES=3        # max second-pass loops to close coverage gaps
# FETCH_TIMEOUT_MS=12000
# ALLOW_PRIVATE_HOSTS=false    # set true only if you must crawl localhost in production
